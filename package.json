{
  "name": "macro-scout",
  "version": "0.7.0",
  "private": true,
  "description": "Macro Scout — Web Verification / Site Inspection API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "tsx src/app.ts",
    "browser:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/credits/*.test.ts src/browser/*.test.ts src/jobs/*.test.ts src/auth/*.test.ts",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "axe-core": "^4.12.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.9.2",
    "morgan": "^1.10.0",
    "pdf-parse": "^1.1.4",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.51.1",
    "pngjs": "^7.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
